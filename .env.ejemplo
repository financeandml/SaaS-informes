# Copiar a .env y rellenar. El .env no se sube al repositorio.

# Obligatorio: la SEC exige identificarse en el User-Agent con nombre y correo.
WC_SEC_CONTACTO="Nombre Apellido correo@dominio.com"

# Opcional: fuente de cotización del día de emisión. Sin ella, precio y capitalización salen N/A.
#   nasdaq   la web del mercado (sin clave)
#   polygon  datos de bolsa licenciados (exige WC_POLYGON_CLAVE)
#   yahoo    solo como último recurso; el informe lo rotula «fuente no oficial»
# WC_PRECIO_FUENTE=nasdaq
# WC_POLYGON_CLAVE=

# Opcional: clave de Claude para `emitir.py --redactar` (redactor automático de la narrativa).
# Solo se envía a api.anthropic.com. Sin ella, los apartados de texto salen pendientes y el informe lo dice.
# ANTHROPIC_API_KEY=

# Donde viven los datos pesados (adjuntos del analista y emisiones): fuera de la copia de trabajo, porque son
# cientos de megas de PDF que no se versionan. Sin esta variable, todo vuelve a «adjuntos/» y «salida/» del repositorio.
WC_DATOS=
