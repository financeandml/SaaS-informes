# Opcional: el SaaS funciona sin .env. Si lo usas, copia este fichero a .env (no se sube al repositorio).

# La SEC exige identificarse en el User-Agent con nombre y correo (solo se envía a EDGAR). Si no lo pones aquí, la página
# lo pide la primera vez y lo guarda en .env.
WC_SEC_CONTACTO=

# Fuente de la cotización: el cierre oficial de Nasdaq (CLAUDE.md, reglas 4 y 6). Sin la variable, vale nasdaq.
WC_PRECIO_FUENTE=nasdaq

# Donde viven los datos (adjuntos, entradas del asistente y emisiones). Sin la variable, «datos-tesis/» del repositorio si
# existe; si no, «adjuntos/», «entradas/» y «salida/» en la raíz.
WC_DATOS=
