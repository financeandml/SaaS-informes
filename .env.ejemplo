# Copiar a .env y rellenar. El .env no se sube al repositorio.

# Obligatorio: la SEC exige identificarse en el User-Agent con nombre y correo (solo se envía a EDGAR).
WC_SEC_CONTACTO="Nombre Apellido correo@dominio.com"

# Fuente de la cotización: el cierre oficial de Nasdaq (CLAUDE.md, reglas 4 y 6). Sin ella, precio y capitalización
# salen N/A con su motivo.
WC_PRECIO_FUENTE=nasdaq

# Donde viven los datos pesados (adjuntos del analista, entradas del asistente y emisiones): fuera de la copia de trabajo,
# porque son cientos de megas de PDF que no se versionan. Sin esta variable, todo vuelve a «adjuntos/», «entradas/» y
# «salida/» del repositorio.
WC_DATOS=
